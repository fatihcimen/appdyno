{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fatihcimen/appdyno",
  "title": "appdyno",
  "description": "Test, drive and measure iOS and Android apps on simulators, emulators and real phones, from a Mac.",
  "version": "1.0.1",
  "websiteUrl": "https://github.com/fatihcimen/appdyno",
