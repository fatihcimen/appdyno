{
  "name": "appdyno",
  "version": "0.6.0",
  "private": false,
  "description": "Drive and measure iOS and Android devices: an MCP stdio server, a command line and a TypeScript library.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatihcimen/appdyno.git",
    "directory": "packages/appdyno"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "appdyno": "dist/main.js",
    "appdyno-mcp": "dist/mcp-bin.js"
  },
  "files": [
    "dist",
    "agents",
    "README.md",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@appdyno/cli": "workspace:*",
    "@appdyno/core": "workspace:*",
    "@appdyno/driver-android": "workspace:*",
    "@appdyno/driver-apple": "workspace:*",
    "@appdyno/mcp": "workspace:*",
    "@appdyno/ops": "workspace:*",
    "@appdyno/perf": "workspace:*",
    "@appdyno/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "esbuild": "^0.28.2",
    "zod": "^4.6.7"
  }
}
