{
  "name": "appdyno",
  "version": "1.1.1",
  "private": false,
  "description": "MCP server, command line and TypeScript library that test, drive and measure iOS and Android apps on simulators, emulators and real phones.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ios",
    "android",
    "iphone",
    "ios-simulator",
    "android-emulator",
    "simulator",
    "emulator",
    "mobile",
    "mobile-testing",
    "mobile-automation",
    "test-automation",
    "e2e-testing",
    "ui-testing",
    "performance",
    "performance-testing",
    "accessibility-testing",
    "screen-mirroring",
    "adb",
    "simctl",
    "xcode",
    "react-native",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "vscode",
    "windsurf",
    "gemini-cli",
    "zed",
    "cline"
  ],
  "license": "MIT",
  "homepage": "https://github.com/fatihcimen/appdyno#readme",
  "bugs": {
    "url": "https://github.com/fatihcimen/appdyno/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatihcimen/appdyno.git",
    "directory": "packages/appdyno"
  },
  "mcpName": "io.github.fatihcimen/appdyno",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "appdyno": "dist/main.js"
  },
  "files": [
    "dist",
    "agents",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "prepack": "test -f agents/android/agent.apk || { echo 'no Android agent: run ./gradlew :agent:assembleDebug in android/, then pnpm build' >&2; exit 1; }",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@appdyno/cli": "workspace:*",
    "@appdyno/core": "workspace:*",
    "@appdyno/driver-android": "workspace:*",
    "@appdyno/driver-apple": "workspace:*",
    "@appdyno/hub": "workspace:*",
    "@appdyno/mcp": "workspace:*",
    "@appdyno/ops": "workspace:*",
    "@appdyno/perf": "workspace:*",
    "@appdyno/protocol": "workspace:*",
    "@appdyno/testing": "workspace:*",
    "@modelcontextprotocol/server": "^2.4.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "zod": "^4.6.7"
  }
}
