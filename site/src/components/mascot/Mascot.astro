---
import type { Words } from '../../i18n/index.ts';
import Rest from './Rest.astro';
import './mascot.css';

interface Props {
  t: Words;
}
const { t } = Astro.props;
---

{/* the dragon's own small box, which goes with it over the page once the page has loaded: until then, and where nothing may move, the hero shows its picture */}
<div class="mascot-layer">
  <canvas class="mascot-view" aria-hidden="true" data-dyno="/models/dyno.glb"></canvas>
  <button class="mascot-body" type="button" aria-label={t.mascot.tap} hidden></button>
</div>
<Rest t={t} corner />
<script>
  import './mascot.client.ts';
</script>
