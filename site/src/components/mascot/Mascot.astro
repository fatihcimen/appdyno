---
import type { Words } from '../../i18n/index.ts';
import Rest from './Rest.astro';
import './mascot.css';

interface Props {
  t: Words;
}
const { t } = Astro.props;
---

{/* drawn over the bench once the page has loaded: until then, and where nothing may move, the bench shows its pictures */}
<div class="mascot-layer">
  <canvas
    class="mascot-view"
    aria-hidden="true"
    data-dyno="/models/dyno.glb"
    data-bench="/models/bench.glb"></canvas>
  <button class="mascot-body" type="button" aria-label={t.mascot.tap} hidden></button>
</div>
<Rest t={t} />
<script>
  import './mascot.client.ts';
</script>
