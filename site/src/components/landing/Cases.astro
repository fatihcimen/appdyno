---
import type { Words } from '../../i18n/index.ts';

interface Props {
  t: Words;
}
const { cases } = Astro.props.t;
const parts = ['problem', 'evidence', 'test'] as const;
---

{/* Three bugs, each from what was reported to the test that holds its fix. */}
<section class="band cases" id="cases">
  <div class="inner">
    <h2 class="reveal">{cases.title}</h2>
    <div class="tools reveal">
      {
        cases.items.map((item) => (
          <article class="tool">
            <b>{item.name}</b>
            <dl>
              {parts.map((part) => (
                <div>
                  <dt>{cases[part]}</dt>
                  <dd set:html={item[part]} />
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
    <p class="note reveal">{cases.note}</p>
  </div>
</section>

<style>
  .cases {
    padding-block: 30px 44px;
  }
  h2 {
    margin-bottom: 18px;
  }
  dl {
    margin: 6px 0 0;
    display: grid;
    gap: 10px;
  }
  dt {
    font: 700 11px var(--f-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amber);
  }
  dd {
    margin: 2px 0 0;
    color: var(--soft);
    font-size: 14px;
  }
  dd :global(code) {
    font-size: 0.92em;
  }
</style>
