---
import type { Words } from '../../i18n/index.ts';

interface Props {
  t: Words;
}
const { cases } = Astro.props.t;
const parts = ['problem', 'evidence', 'test'] as const;
---

{/* Three bugs, each from what was reported to the test that holds its fix. */}
<section class="band cases" id="cases">
  <div class="inner">
    <h2 data-perch>{cases.title}</h2>
    <div class="cards" data-perch>
      {
        cases.items.map((item) => (
          <article>
            <h3>{item.name}</h3>
            <dl>
              {parts.map((part) => (
                <div>
                  <dt>{cases[part]}</dt>
                  <dd set:html={item[part]} />
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
    <p class="note">{cases.note}</p>
  </div>
</section>

<style>
  h2 {
    margin-bottom: 32px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }
  article {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 24px;
  }
  h3 {
    font: 700 19px / 1.25 var(--f-display);
    margin: 0 0 16px;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 12px;
  }
  dt {
    font: 600 13px var(--f-ui);
    color: var(--amber);
  }
  dd {
    margin: 2px 0 0;
    color: var(--soft);
    font-size: 15px;
  }
  dd :global(code) {
    font: 400 0.92em var(--f-mono);
    color: var(--blue-lt);
  }
</style>
