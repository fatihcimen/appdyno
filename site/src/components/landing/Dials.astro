---
import type { Words } from '../../i18n/index.ts';
import Dial from './Dial.astro';

interface Props {
  t: Words;
}
const { bench, dials } = Astro.props.t;
---

{/* The bench's front panel: cold launch, frames and memory. Every dial of the page takes its gradients from here. */}
<div class="gauges">
  <svg class="defs" width="0" height="0" aria-hidden="true">
    <defs>
      <linearGradient id="dial-bezel" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#eef1ff"></stop>
        <stop offset=".45" stop-color="#7c82ad"></stop>
        <stop offset="1" stop-color="#23264a"></stop>
      </linearGradient>
      <linearGradient id="dial-rim" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1a1d3b"></stop>
        <stop offset="1" stop-color="#9aa0c6"></stop>
      </linearGradient>
      <radialGradient id="dial-face" cx=".5" cy=".4" r=".7">
        <stop offset="0" style="stop-color: var(--dial-face)"></stop>
        <stop offset="1" style="stop-color: var(--dial-pit)"></stop>
      </radialGradient>
      <radialGradient id="dial-hub" cx=".4" cy=".35" r=".7">
        <stop offset="0" stop-color="#ffffff"></stop>
        <stop offset=".5" stop-color="#9aa0c6"></stop>
        <stop offset="1" stop-color="#2a2e55"></stop>
      </radialGradient>
      <linearGradient id="dial-glass" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity=".22"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
  </svg>
  <Dial id="launch" label={bench.launch} />
  <Dial id="frames" label={bench.frames} />
  <Dial id="memory" label={bench.memory} />
  <p class="example">{dials.example}</p>
</div>

<style>
  .gauges {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 12px 14px 14px;
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, var(--gauge-top), var(--gauge-bottom));
  }
  .defs {
    position: absolute;
  }
  .example {
    grid-column: 1 / -1;
    margin: 4px 0 0;
    text-align: center;
    font-size: 12px;
    color: var(--soft);
  }
</style>
