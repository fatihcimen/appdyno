---
import type { Words } from '../../i18n/index.ts';

interface Props {
  t: Words;
}
const { rack } = Astro.props.t;
---

<section class="band rack" id="tools">
  <div class="inner">
    <h2>{rack.title}</h2>
    <p class="sub">{rack.sub}</p>
    <div class="tools" data-perch>
      {
        rack.tools.map((tool) => (
          <div class="tool">
            <b>{tool.name}</b>
            <p>{tool.text}</p>
            <code>{tool.code}</code>
          </div>
        ))
      }
    </div>
    <p class="safe">{rack.safe}</p>
  </div>
</section>
