---
import type { Words } from '../../i18n/index.ts';
import { REGISTRY, REPO, type Lang } from '../../site.ts';

interface Props {
  lang: Lang;
  t: Words;
}
const { lang, t } = Astro.props;
const { source } = t;
const file = (name: string) => `${REPO}/blob/main/${name}`;
---

{/* Open source, in one band: where it runs, the license, the repository to star, where it is listed and how to take part. */}
<section class="band source" id="source">
  <div class="inner" data-perch>
    <div>
      <h2>{source.title}</h2>
      <p class="sub">{source.local}</p>
    </div>
    <ul>
      <li><a href={file('LICENSE')}>{source.license}</a></li>
      <li><a href={REPO}>{source.star}</a></li>
      <li><a href={file(lang === 'tr' ? 'CONTRIBUTING.tr.md' : 'CONTRIBUTING.md')}>{source.contribute}</a></li>
      <li>{source.registry} <code>{REGISTRY}</code></li>
    </ul>
  </div>
</section>

<style>
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px 48px;
    align-items: center;
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--panel);
  }
  @media (max-width: 860px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .sub {
    margin: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 15px;
    color: var(--soft);
  }
  code {
    font: 400 0.92em var(--f-mono);
    color: var(--fg);
    overflow-wrap: anywhere;
  }
</style>
