---
import { SCALES, faceOf, turn, type Gauge } from './dials.ts';
import { READINGS } from './scenarios.ts';

interface Props {
  id: Gauge;
  /** What the dial measures, under its readout. */
  label?: string;
}
const { id, label } = Astro.props;
const scale = SCALES[id];
const face = faceOf(scale);
const [reading, share] = READINGS[id];
---

{/* One instrument: its gradients are Dials.astro's, and a step of a job turns #n-<id> and writes #v-<id>. */}
<div class="dial">
  <svg viewBox="0 0 200 200" aria-hidden="true">
    <circle cx="100" cy="100" r="97" fill="url(#dial-bezel)"></circle>
    <circle cx="100" cy="100" r="90" fill="url(#dial-rim)"></circle>
    <circle cx="100" cy="100" r="86" fill="url(#dial-face)"></circle>
    {face.bands.map((band) => <path class={`band ${band.kind}`} d={band.d} />)}
    {
      face.ticks.map((tick) => (
        <line
          class:list={['tick', { big: tick.big }]}
          x1={tick.from[0]}
          y1={tick.from[1]}
          x2={tick.to[0]}
          y2={tick.to[1]}
        />
      ))
    }
    {
      face.ticks
        .filter((tick) => tick.big)
        .map((tick) => (
          <text x={tick.number[0]} y={tick.number[1]}>
            {tick.value}
          </text>
        ))
    }
    <text class="unit" x="100" y="150">{scale.unit}</text>
    <path
      class="needle"
      id={`n-${id}`}
      d="M100 30L103.5 100 100 116 96.5 100Z"
      style={`transform: ${turn(share)}`}></path>
    <circle cx="100" cy="100" r="10" fill="url(#dial-hub)"></circle>
    <circle class="pin" cx="100" cy="100" r="3.5"></circle>
    <path d="M22 84A80 80 0 0 1 178 84A120 70 0 0 0 22 84Z" fill="url(#dial-glass)"></path>
  </svg>
  <div class="lcd" id={`v-${id}`}>{reading}</div>
  {label && <div class="l">{label}</div>}
</div>

<style>
  .dial {
    text-align: center;
    min-width: 0;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 190px;
    height: auto;
    margin: 0 auto;
    filter: drop-shadow(0 0 12px color-mix(in oklab, var(--blue) 45%, transparent));
  }
  .band {
    fill: none;
    stroke-width: 6;
  }
  .good {
    stroke: var(--dial-good);
  }
  .warn {
    stroke: var(--dial-warn);
  }
  .slow {
    stroke: var(--dial-slow);
  }
  .tick {
    stroke: var(--dial-ink);
    stroke-width: 1;
    opacity: 0.6;
  }
  .tick.big {
    stroke-width: 2.4;
    opacity: 1;
  }
  text {
    font: 700 15px var(--f-mono);
    fill: var(--dial-ink);
    text-anchor: middle;
    dominant-baseline: central;
  }
  text.unit {
    font-size: 12px;
    fill: var(--dial-dim);
    letter-spacing: 0.08em;
  }
  /* the needle goes past its reading and comes back to it, at the page's start and at each new reading */
  .needle {
    fill: var(--dial-needle);
    transform-origin: 100px 100px;
    transition: transform 1.1s cubic-bezier(0.3, 1.55, 0.45, 1);
    animation: settle 1.4s cubic-bezier(0.3, 1.55, 0.45, 1) backwards;
  }
  @keyframes settle {
    from {
      transform: rotate(-120deg);
    }
  }
  .pin {
    fill: var(--dial-pit);
  }
  .lcd {
    display: inline-block;
    margin-top: 6px;
    min-width: 8ch;
    padding: 3px 8px;
    border-radius: 8px;
    background: var(--dial-pit);
    border: 1px solid var(--frame);
    box-shadow: inset 0 2px 6px #000;
    font: 700 16px var(--f-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--lcd-ink);
  }
  .l {
    margin-top: 4px;
    font: 400 11px var(--f-mono);
    color: var(--soft);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @media (prefers-reduced-motion: reduce) {
    .needle {
      transition: none;
      animation: none;
    }
  }
</style>
