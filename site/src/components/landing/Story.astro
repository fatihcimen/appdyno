---
import type { Words } from '../../i18n/index.ts';
import Dial from './Dial.astro';
import Phone from './Phone.astro';
import { SCENES, lineOf, storyOf } from './scenarios.ts';
import type { StoryData } from './scroll.client.ts';

interface Props {
  t: Words;
}
const { t } = Astro.props;
const { story } = t;
const scenes: StoryData = storyOf(t);
// the log of the first scene is in the page as it comes, for a reader with no script
const first = scenes[SCENES[0]]?.flatMap((step) => lineOf(step) ?? []).join('\n');
---

{/* What the agent does with one request, as six scenes. With no script it is a list beside two phones; scroll.client.ts plays each scene on the phones as its step reaches the middle of the window. */}
<section class="band story" id="story">
  <div class="inner">
    <div class="reveal">
      <h2>{story.title}</h2>
      <p class="sub">{story.sub}</p>
    </div>
    <div class="grid">
      <ol class="steps">
        {
          SCENES.map((scene) => (
            <li class="step" data-scene={scene}>
              <h3>{story.steps[scene].name}</h3>
              <p set:html={story.steps[scene].text} />
            </li>
          ))
        }
      </ol>
      {/* a picture of what the steps say: nothing in it is to be read or reached */}
      <div class="pinned" aria-hidden="true" inert>
        <div class="phones">
          <div class="slot">
            <span class="tag">{story.ios}</span>
            <Phone t={t} model="iPhone 17" />
          </div>
          <div class="slot">
            <span class="tag">{story.android}</span>
            <Phone t={t} model="Pixel 9" android />
          </div>
          <div class="side"><Dial id="story" /></div>
        </div>
        <pre class="slog" id="story-log" set:html={first} />
      </div>
    </div>
  </div>
</section>
<script
  type="application/json"
  id="story-data"
  is:inline
  set:html={JSON.stringify(scenes).replaceAll('<', '\\u003c')}
/>
<script>
  import './scroll.client.ts';
</script>

<style>
  .story {
    padding-block: 44px 20px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.25fr);
    gap: 36px;
    align-items: start;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
    counter-reset: step;
  }
  .step {
    counter-increment: step;
    padding-left: 18px;
    border-left: 3px solid var(--line);
    color: var(--soft);
    transition:
      color 0.3s,
      border-color 0.3s;
  }
  .step h3 {
    font: 800 clamp(22px, 2.6vw, 30px) / 1.1 var(--f-display);
    color: var(--fg);
    margin: 0 0 8px;
  }
  .step h3::before {
    content: '0' counter(step);
    display: block;
    font: 700 12px var(--f-mono);
    color: var(--amber);
    letter-spacing: 0.14em;
    margin-bottom: 6px;
  }
  .step p {
    margin: 0;
    max-width: 40ch;
  }
  .step :global(code) {
    font: 400 0.92em var(--f-mono);
    color: var(--blue-lt);
  }
  .pinned {
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--panel);
    padding: 14px;
  }
  .phones {
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: flex-start;
  }
  .slot {
    text-align: center;
  }
  .tag {
    display: block;
    font: 400 11px var(--f-mono);
    color: var(--muted);
    margin-bottom: 6px;
  }
  .pinned :global(.phone) {
    zoom: 0.74;
    text-align: left;
    transition: opacity 0.5s;
  }
  /* the second phone waits for the replay, dimmed and never gone */
  .pinned :global(.phone.idle) {
    opacity: 0.3;
  }
  .side {
    flex: 0 1 200px;
    min-width: 0;
  }
  .slog {
    margin: 12px 0 0;
    padding: 10px 12px;
    min-height: 9.2em;
    border-radius: 12px;
    background: var(--term);
    border: 1px solid var(--line);
    font: 400 12px/1.6 var(--f-mono);
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--term-fg);
  }

  /* with the script playing, each step has a part of the page to itself and the phones stay beside it */
  .playing .steps {
    gap: 0;
  }
  .playing .step {
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--muted);
  }
  .playing .step.on {
    color: var(--soft);
    border-left-color: var(--magenta-lt);
  }
  .playing .pinned {
    position: sticky;
    top: 16px;
  }

  @media (min-width: 1001px) and (max-height: 760px) {
    .pinned :global(.phone) {
      zoom: 0.56;
    }
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }
    .pinned {
      order: -1;
      padding: 8px;
    }
    .pinned :global(.phone) {
      zoom: 0.46;
    }
    .side {
      flex-basis: 150px;
    }
    .slog {
      min-height: 6.2em;
      max-height: 6.2em;
      overflow: hidden;
      font-size: 11px;
      margin-top: 8px;
    }
    .playing .grid {
      gap: 0;
    }
    .playing .pinned {
      top: 0;
      z-index: 3;
      border-top: 0;
      border-radius: 0 0 18px 18px;
      margin-inline: -8px;
    }
    .playing .step {
      min-height: 56vh;
    }
  }
  @media (max-width: 560px) {
    .side {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .step,
    .pinned :global(.phone) {
      transition: none;
    }
  }
</style>
