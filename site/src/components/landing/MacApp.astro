---
import type { Words } from '../../i18n/index.ts';
import { RELEASES, type Lang } from '../../site.ts';

interface Props {
  lang: Lang;
  t: Words;
}
const { lang, t } = Astro.props;
const { mac } = t;
// the hub was pictured in each language, from docs/images, which the site serves at /docs/images
const hub = `/docs/images/${lang === 'tr' ? 'hub.tr.webp' : 'hub.webp'}`;
---

{/* The Mac app: the hub as it is, what it is for, and where to download it. */}
<section class="band mac" id="mac">
  <div class="inner">
    <h2 data-perch>{mac.title}</h2>
    <p class="sub">{mac.sub}</p>
    <div class="grid">
      <img
        src={hub}
        width="1240"
        height="820"
        alt={mac.shot}
        loading="lazy"
        decoding="async"
      />
      <div>
        <ul>
          {
            mac.points.map((point) => (
              <li>
                <b>{point.name}</b>
                <span set:html={point.text} />
              </li>
            ))
          }
        </ul>
        <a class="btn" href={`${RELEASES}/latest`}>{mac.download}</a>
        <p class="note">{mac.after}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    margin-top: 32px;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  ul {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  li {
    color: var(--soft);
  }
  li b {
    display: block;
    color: var(--fg);
    font: 700 17px var(--f-display);
    margin-bottom: 2px;
  }
  li :global(code) {
    font: 400 0.92em var(--f-mono);
    color: var(--blue-lt);
  }
</style>
