---
import type { Words } from '../../i18n/index.ts';
import type { ConsoleData } from './landing.client.ts';
import { jobsOf, refOf } from './scenarios.ts';

interface Props {
  t: Words;
}
const { t } = Astro.props;
const c = t.console;
const jobs = jobsOf(t);
const chips: Record<string, string> = {
  checkout: c.checkout.chip,
  push: c.push.chip,
  link: c.link.chip,
  perf: c.perf.chip,
  views: c.views.chip,
};
const data: ConsoleData = { jobs, running: c.running, done: c.done };
const cart = `${c.app.cart} 0`;
---

<section class="band console" id="console">
  <div class="inner">
    <h2>{c.title}</h2>
    <p class="sub">{c.sub}</p>
    <div class="chips" role="group" aria-label={c.jobs}>
      {
        Object.keys(jobs).map((job) => (
          <button class="chip" type="button" data-run={job} aria-pressed="false">
            {chips[job]}
          </button>
        ))
      }
    </div>
    <div class="rig">
      <div class="phone" id="phone" role="img" aria-label={c.phone}>
        <div class="status"><span>9:41</span><span>iPhone 17</span></div>
        <div class="app">
          <header>
            <span id="title" data-rest={c.app.name}>{c.app.name}</span>
            <span class="cart ref" data-ref="@cart" id="cart" data-rest={cart}>{cart}</span>
          </header>
          {
            c.app.products.map((name, i) => (
              <div class="item ref" data-ref={refOf(i)}>
                <i />
                <div>
                  <b>{name}</b>
                  <small>{c.app.prices[i]}</small>
                </div>
                <span class="add">{c.app.add}</span>
              </div>
            ))
          }
          <span class="place ref" data-ref="@place">{c.app.place}</span>
        </div>
        <div class="banner" id="banner"><b>{c.app.name}</b><span>{c.app.pushBody}</span></div>
        <div class="overlay" id="crash"><div><b>{c.app.stopped}</b>{c.app.stoppedAt}</div></div>
      </div>
      <div class="term" aria-live="polite">
        <div class="bar"><span>{c.client}</span><span id="clock">{c.ready}</span></div>
        <pre id="out"><span class="d">{c.idle}</span></pre>
      </div>
    </div>
  </div>
</section>
<script type="application/json" id="console-data" is:inline set:html={JSON.stringify(data).replaceAll('<', '\\u003c')} />
