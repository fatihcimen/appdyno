---
import { getImage } from 'astro:assets';
import benchPoster from '../../assets/bench.webp';
import dynoPoster from '../../assets/dyno.webp';
import type { Words } from '../../i18n/index.ts';
import Mascot from '../mascot/Mascot.astro';
import Dials from './Dials.astro';

interface Props {
  t: Words;
}
const { t } = Astro.props;
const { bench } = t;
const poster = async (src: ImageMetadata) => getImage({ src, format: 'webp', width: 640 });
// each model's picture, where the scene draws the model once it is there
const pictures = [
  { id: 'dyno', alt: bench.dragon, poster: await poster(dynoPoster) },
  { id: 'rig', alt: bench.phone, poster: await poster(benchPoster) },
];
---

<div class="bench" role="group" aria-label={bench.label}>
  <div class="stage">
    {
      pictures.map(({ id, alt, poster }) => (
        <img
          class={id}
          src={poster.src}
          width={poster.attributes.width}
          height={poster.attributes.height}
          alt={alt}
          decoding="async"
        />
      ))
    }
  </div>
  <Dials t={t} />
  <div class="stripes"></div>
  <Mascot t={t} />
</div>
