{
  "extends": "./tsconfig.packages.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["**/*.mjs"],
  "exclude": ["**/node_modules", "**/dist", "**/build", "android", "ios"]
}
