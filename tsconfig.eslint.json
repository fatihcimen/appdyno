{
  "extends": "./tsconfig.packages.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "packages/*/scripts",
    "packages/*/examples",
    "device-tests",
    "scripts/*.mjs",
    "*.js",
    "*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
